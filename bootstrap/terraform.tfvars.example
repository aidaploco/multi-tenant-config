# Copy to terraform.tfvars and fill in your real values. terraform.tfvars is gitignored.

org_id                     = "123456789012"          # numeric org ID
billing_account            = "012345-6789AB-CDEF01"  # billing account ID
allowed_domain_customer_id = "C01abc234"             # Cloud Identity customer ID (NOT the domain)

github_org  = "aidaploco"
github_repo = "multi-tenant-config"

# Optional — sensible defaults exist:
# management_project_id = "platform-management"
# state_bucket_name     = "platform-management-tfstate"
# region                = "europe-west4"
